# ============================================
# COLLABSPACE BACKEND — ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in all values.
# NEVER commit the actual .env file to git.

# -------- Server --------
NODE_ENV=development
PORT=5000
API_VERSION=v1

# -------- MongoDB --------
# Use MongoDB Atlas connection string in production.
# Include the database name in the URI.
MONGO_URI=mongodb://localhost:27017/collabspace

# -------- Redis --------
# Use Upstash Redis URL in production (REDIS_URL includes credentials).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# For production with Upstash:
# REDIS_URL=redis://default:<password>@<host>:<port>

# -------- JWT --------
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET_DO_NOT_USE_THIS_IN_PRODUCTION
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET_DO_NOT_USE_IN_PRODUCTION
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -------- Cookie --------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# -------- CORS --------
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -------- Rate Limiting --------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -------- Bcrypt --------
BCRYPT_SALT_ROUNDS=12

# -------- Logging --------
LOG_LEVEL=debug
